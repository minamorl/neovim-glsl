# secret.no_commit: forbid secret.location = repo
# secret.source:    require secret.source = env_or_vault
# 秘密は env または vault から来る。repository には置かない。
.env
.env.*
*.pem
*.key
secrets/

# Assembled app bundles. Both are build output — `make-app.sh` rebuilds either
# in seconds — and a committed one is worse than useless: it is a binary in the
# history, and macOS indexes every .app under the home directory, so a bundle
# sitting in the working tree shows up in Launchpad beside the installed copy
# under the same name.
target/
nvimgl.app/
nvimglsl.app/
# Neovim drops this where a test ran it. Empty, and not ours.
.nvimlog
.DS_Store
